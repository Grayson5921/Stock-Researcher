# ---------------------------------------------------------------------------
# Copy to ".env" for local dev.  NEVER commit a real .env.
# All secrets live server-side only — none of these are exposed to the browser
# (only NEXT_PUBLIC_* vars ever reach the client, and there are intentionally
# none that carry secrets).
# ---------------------------------------------------------------------------

# --- Core infra -------------------------------------------------------------
DATABASE_URL=postgres://stockresearcher:stockresearcher@localhost:5432/stockresearcher
REDIS_URL=redis://localhost:6379

# 32+ byte random string used to sign session cookies (HMAC). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Public base URL of the app (used for Stripe redirect URLs).
APP_URL=http://localhost:3000

# --- Anthropic (server-side ONLY — never per-user, never in the browser) -----
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- Market data ------------------------------------------------------------
# Keyless Yahoo endpoints are fine for local dev but are NOT licensed for
# commercial use. For production set MARKET_DATA_PROVIDER=finnhub and provide a
# paid Finnhub key. EDGAR stays free; set a real contact UA per SEC policy.
MARKET_DATA_PROVIDER=yahoo
FINNHUB_API_KEY=
SEC_USER_AGENT=stock-researcher contact@example.com

# --- Stripe -----------------------------------------------------------------
# Test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Price for a one-time Research Run ($20.00). Either a Stripe Price ID or a
# raw cents amount for ad-hoc price_data. Priced at the $15 job cost ceiling + $5 margin.
RESEARCH_RUN_PRICE_CENTS=2000

# --- Guardrails -------------------------------------------------------------
# Hard per-job cost ceiling (USD). A run is aborted politely if estimated spend
# crosses this; the run credit is auto-refunded.
JOB_COST_CEILING_USD=15
# Per-user model-call cap per calendar day (defense-in-depth).
USER_DAILY_CALL_CAP=2000
# Global daily API budget kill-switch (USD). New jobs refuse to start above it.
GLOBAL_DAILY_BUDGET_USD=500

# --- Dev conveniences -------------------------------------------------------
# When "1", the worker emits a canned progress stream + sample report instead of
# calling Anthropic. Lets you exercise the full sign-up -> pay -> run -> report
# path end-to-end with zero API spend. MUST be unset/0 in production.
MOCK_WORKFLOW=0
# When "1", enables POST /api/dev/grant-credit (local testing without Stripe).
# MUST be unset/0 in production.
ENABLE_DEV_CREDITS=0

NODE_ENV=development
