{
  "name": "stock-researcher-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Paid web product wrapping the multi-agent stock research workflow (Phase 1).",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx worker/index.ts",
    "worker:dev": "tsx watch worker/index.ts",
    "migrate": "node db/migrate.mjs",
    "seed": "node db/seed.mjs",
    "grant-credit": "node db/grant-credit.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "agent:cli": "node agent-core/main.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.12.0",
